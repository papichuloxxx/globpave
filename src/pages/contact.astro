---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/site';

const mapQuery = encodeURIComponent(`${business.address.street}, ${business.address.locality}, ${business.address.countryName}`);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact Globpave Construction',
    url: `${business.url}/contact/`,
    about: { '@id': `${business.url}/#business` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: business.url },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${business.url}/contact/` },
    ],
  },
];
---

<Base
  title="Contact Globpave Construction | Free Paving & Building Quotes, Harare"
  description="Call +263 772 900 562, WhatsApp or email info@globpaveconstruction.co.zw for a free quote. 684 Glenwood, Glen Lorne, Harare, Zimbabwe."
  keywords={['contact paving company Harare', 'construction quote Harare', 'Globpave contact']}
  schema={schema}
>
  <PageHero
    eyebrow="Contact"
    title="Let’s talk about your project"
    lead="Call, WhatsApp or send the form below. Site visits and quotes are free."
    crumbs={[{ href: '/contact/', label: 'Contact' }]}
  />

  <section class="section">
    <div class="container contact">
      <aside class="contact__info">
        <div class="info">
          <span class="info__icon"><Icon name="phone" /></span>
          <div>
            <h2>Call us</h2>
            {business.phones.map((p) => <a href={`tel:${p.tel}`}>{p.display}</a>)}
          </div>
        </div>
        <div class="info">
          <span class="info__icon info__icon--wa"><Icon name="whatsapp" /></span>
          <div>
            <h2>WhatsApp</h2>
            <a href={`https://wa.me/${business.whatsapp}`} target="_blank" rel="noopener">{business.phones[0].display}</a>
          </div>
        </div>
        <div class="info">
          <span class="info__icon"><Icon name="mail" /></span>
          <div>
            <h2>Email</h2>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </div>
        </div>
        <div class="info">
          <span class="info__icon"><Icon name="pin" /></span>
          <div>
            <h2>Visit</h2>
            <address>
              {business.address.street}<br />
              {business.address.locality}, {business.address.countryName}
            </address>
            <a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener">
              Open in Google Maps
            </a>
          </div>
        </div>
      </aside>

      <div class="card">
        <h2 class="card__title">Request a free quote</h2>
        <QuoteForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .contact__info {
    display: grid;
    gap: 16px;
  }
  .info {
    display: flex;
    gap: 18px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .info h2 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .info a {
    display: block;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .info a:hover {
    color: var(--blue-600);
  }
  .info address {
    font-style: normal;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .info address + a {
    font-weight: 600;
    color: var(--blue-600);
    font-size: 0.95rem;
  }
  .info__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--blue-50);
    color: var(--blue-600);
  }
  .info__icon--wa {
    background: #dcf8e7;
    color: #128c4a;
  }
  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: clamp(24px, 4vw, 40px);
    box-shadow: var(--shadow-lg);
  }
  .card__title {
    font-size: 1.8rem;
    margin-bottom: 24px;
  }
  @media (max-width: 880px) {
    .contact {
      grid-template-columns: 1fr;
    }
    .card {
      order: -1;
    }
  }
</style>
