---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { business, services } from '../../data/site';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: business.url },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${business.url}/services/` },
  ],
};
---

<Base
  title="Construction & Paving Services in Harare | Globpave Construction"
  description="Paving, driveways, building, civil works, road construction, plumbing, boreholes, roofing, ceilings, tiling, fencing and electrical services in Harare, Zimbabwe."
  keywords={services.flatMap((s) => s.keywords.slice(0, 2))}
  schema={[breadcrumb]}
>
  <PageHero
    eyebrow="Our services"
    title="Construction services under one roof"
    lead="Six specialist divisions, one accountable team. Whatever stage your project is at, Globpave has the skills and equipment to deliver it."
    crumbs={[{ href: '/services/', label: 'Services' }]}
  />

  <section class="section">
    <div class="container">
      <ServicesGrid />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container all">
      <div class="section-head">
        <p class="eyebrow">Full list</p>
        <h2>Every service we offer</h2>
      </div>
      <div class="all__grid">
        {
          services.map((s) => (
            <div>
              <h3>
                <a href={`/services/${s.slug}/`}>{s.title}</a>
              </h3>
              <ul class="check-list">
                {s.items.map((i) => (
                  <li>{i.name}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .all__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 40px 32px;
  }
  .all h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .all h3 a:hover {
    color: var(--blue-600);
  }
  .all h3 {
    padding-bottom: 14px;
    margin-bottom: 18px;
    border-bottom: 2px solid var(--blue-600);
  }
</style>
