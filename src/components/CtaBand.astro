---
import Icon from './Icon.astro';
import { business } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to start your project?',
  text = 'Tell us what you need and we will arrange a site visit and a clear, itemised quote.',
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__box">
      <div class="cta__copy">
        <h2 id="cta-title">{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href="/contact/#quote">Get a Free Quote <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href={`tel:${business.phones[0].tel}`}><Icon name="phone" /> {business.phones[0].display}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(48px, 7vw, 88px);
  }
  .cta__box {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(32px, 5vw, 64px);
    border-radius: 24px;
    background: var(--ink);
    color: #c9d2e0;
    isolation: isolate;
  }
  .cta__box::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(600px 300px at 100% 0%, rgb(37 99 235 / 0.45), transparent 70%),
      url('/pavers.svg') right center / 360px repeat;
    opacity: 0.9;
  }
  .cta__copy {
    max-width: 560px;
  }
  .cta h2 {
    color: #fff;
  }
  .cta p {
    margin: 0;
    font-size: 1.1rem;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
