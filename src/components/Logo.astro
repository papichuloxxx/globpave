---
import { Image } from 'astro:assets';
import logo from '../assets/globpave-logo.png';

interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
---

<span class:list={['logo', { 'logo--inverted': inverted }]}>
  <Image
    src={logo}
    alt="Globpave Construction — Pavers & Paving Specialists"
    widths={[240, 480]}
    sizes={inverted ? '180px' : '(max-width: 880px) 120px, 146px'}
    class="logo__img"
    loading="eager"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
  }
  .logo__img {
    display: block;
    height: 78px;
    width: auto;
  }
  @media (max-width: 880px) {
    .logo__img {
      height: 64px;
    }
  }
  /* The artwork has black lettering, so on dark backgrounds it sits on a light badge */
  .logo--inverted {
    background: #fff;
    border-radius: 12px;
    padding: 10px 14px;
  }
  .logo--inverted .logo__img {
    height: 96px;
  }
</style>
