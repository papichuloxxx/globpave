---
interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
---

<span class:list={['logo', { 'logo--inverted': inverted }]}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="17" fill="#1d4fd8" />
    <path
      d="M3 20h34M20 3c-5 5-7 11-7 17s2 12 7 17M20 3c5 5 7 11 7 17s-2 12-7 17M6 12h28M6 28h28"
      fill="none"
      stroke="#fff"
      stroke-width="1.6"
      opacity=".85"
    />
    <ellipse cx="20" cy="21" rx="21" ry="6.5" fill="none" stroke="currentColor" stroke-width="2.4" transform="rotate(-18 20 21)" />
  </svg>
  <span class="logo__text">
    <span class="logo__name">Globpave</span>
    <span class="logo__sub">Construction</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }
  .logo--inverted {
    color: #fff;
  }
  .logo__mark {
    width: 40px;
    height: 40px;
    flex: none;
    overflow: visible;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--blue-600);
  }
  .logo--inverted .logo__name {
    color: #fff;
  }
  .logo__sub {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin-top: 4px;
  }
</style>
