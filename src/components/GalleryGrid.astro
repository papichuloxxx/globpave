---
import { Image, getImage } from 'astro:assets';
import type { GalleryItem } from '../data/gallery';

interface Props {
  items: GalleryItem[];
  /** Groups items so the lightbox only steps through photos in the same grid */
  group: string;
}
const { items, group } = Astro.props;

const full = await Promise.all(items.map((i) => getImage({ src: i.image, width: Math.min(1600, i.image.width), format: 'webp', quality: 80 })));
---

<ul class="gallery">
  {
    items.map((item, idx) => (
      <li>
        <button
          type="button"
          class="gallery__item"
          data-lightbox={group}
          data-full={full[idx].src}
          data-caption={item.caption}
          data-alt={item.alt}
          aria-label={`View larger: ${item.caption}`}
        >
          <Image
            src={item.image}
            alt={item.alt}
            widths={[320, 480, 720]}
            sizes="(max-width: 560px) 50vw, (max-width: 1000px) 33vw, 280px"
            format="webp"
            quality={75}
          />
          <span class="gallery__caption">{item.caption}</span>
        </button>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 14px;
  }
  .gallery > li {
    min-width: 0;
  }
  .gallery__item {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg-soft);
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
  }
  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gallery__item:hover :global(img),
  .gallery__item:focus-visible :global(img) {
    transform: scale(1.04);
  }
  .gallery__item:focus-visible {
    outline: 3px solid var(--blue-500);
    outline-offset: 3px;
  }
  .gallery__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 28px 12px 10px;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: left;
    color: #fff;
    background: linear-gradient(transparent, rgb(11 18 32 / 0.78));
  }
  @media (max-width: 560px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .gallery__caption {
      font-size: 0.75rem;
      padding: 20px 8px 7px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery__item :global(img) {
      transition: none;
    }
  }
</style>
